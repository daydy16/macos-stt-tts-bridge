<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.daydy16.sttbridge</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/STTBridge.app/Contents/MacOS/STTBridge</string>
        <string>--headless</string>
    </array>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <true/>
    
    <key>StandardOutPath</key>
    <string>/tmp/sttbridge.log</string>
    
    <key>StandardErrorPath</key>
    <string>/tmp/sttbridge.error.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>

        <!-- STT backend: speechanalyzer (default) | legacy | whisperkit -->
        <key>STT_ENGINE</key>
        <string>speechanalyzer</string>
        <key>DEFAULT_LANG</key>
        <string>de-DE</string>

        <!-- HTTP/WebSocket (browser test UI + existing HA custom integration).
             Set BIND_HOST=0.0.0.0 if Home Assistant uses the custom HTTP/WS
             integration and runs on a different host. -->
        <key>BIND_HOST</key>
        <string>127.0.0.1</string>
        <key>PORT</key>
        <string>8787</string>

        <!-- Wyoming TCP transport (native HA integration, auto-discovered). -->
        <key>WYOMING_ENABLED</key>
        <string>true</string>
        <key>WYOMING_PORT</key>
        <string>10700</string>
    </dict>
</dict>
</plist>
